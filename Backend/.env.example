PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017
PRODUCT_PER_PAGE=8

# Long random string used to sign login tokens
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d


# Admin account created/updated by "npm run seed"
ADMIN_EMAIL=admin@supersaint.local
ADMIN_PASSWORD=change-me

# Razorpay keys (Dashboard > Account & Settings > API Keys). Test keys start with rzp_test_.
# Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
